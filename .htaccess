# ==============================================================================
# CONFIGURACIÓN APACHE / LITESPEED - HOSTINGER
# Single Page Application (SPA) - Nor Celis Automotriz
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OPCIONES DE SEGURIDAD Y EXPLORACIÓN
# ------------------------------------------------------------------------------
# Deshabilita el listado público de directorios en el servidor
Options -Indexes

# Establece codificación de caracteres predeterminada a UTF-8
AddDefaultCharset UTF-8

# Bloquea acceso a archivos ocultos, sensibles o de configuración (.env, .git, json)
<FilesMatch "^\.(env|git|htaccess|htpasswd)|package(-lock)?\.json|tsconfig\.json$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# 2. ENRUTAMIENTO SPA (VITE / REACT) Y REESCRITURA DE URLS
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forzar HTTPS automático (con certificado SSL en Hostinger)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Excluir subdirectorios existentes para no interceptar la Intranet u otros sistemas
  RewriteRule ^intranet(/.*)?$ - [L]

  # Excluir rutas de WordPress en caso de convivir en el mismo servidor
  RewriteRule ^(wp-admin|wp-content|wp-includes|wp-json)(/.*)?$ - [L]

  # Si la petición coincide con un archivo físico existente (JS, CSS, imágenes), servirlo directamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  # Si la petición coincide con una carpeta física existente, servirla directamente
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback: redirigir todas las demás rutas de la SPA hacia index.html
  RewriteRule ^ index.html [L]
</IfModule>

# ------------------------------------------------------------------------------
# 3. POLÍTICA DE CACHÉ INTELIGENTE (EVITA PANTALLAS EN BLANCO EN ACTUALIZACIONES)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # index.html siempre fresco: el navegador detecta nuevos despliegues de inmediato
  ExpiresByType text/html "access plus 0 seconds"

  # Archivos con hash inmutable generados por Vite (/assets/): caché larga de 1 año
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  
  # Imágenes y recursos multimedia
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Tipografías web
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Prevenir almacenamiento en caché del index.html
  <Files "index.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </Files>

  # Cache inmutable para los bundles estáticos con hash
  <FilesMatch "\.(js|css|webp|avif|png|jpg|jpeg|svg|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Cabeceras de seguridad HTTP
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ------------------------------------------------------------------------------
# 4. COMPRESIÓN GZIP / DEFLATE (LITESPEED / APACHE)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
