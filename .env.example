# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# NOR CELIS AUTOMOTRIZ - HOSTINGER & WORDPRESS CONFIGURATION
# ==============================================================================
# URL directa de la Intranet corporativa existente en Hostinger:
VITE_INTRANET_URL="https://norcelis.pe/intranet"

# URL base para conectar con la REST API de WordPress o PHP en Hostinger:
VITE_API_BASE_URL="https://norcelis.pe/wp-json/norcelis/v1"

# Activar consumo remoto de la base de datos de Hostinger (true/false):
VITE_ENABLE_REMOTE_API="false"


# ==============================================================================
# VERIFICACIÓN DE PLACA (Registro Vehicular / SUNARP vía proveedor autorizado)
# SUNARP no tiene API pública gratuita; usa un proveedor (algunos ofrecen plan de prueba).
# Si no se configura, los vehículos se guardan como "no verificados".
# ==============================================================================
# URL del proveedor. Usa {plate} y, si el proveedor pide el token en la URL, {token}
PLATE_API_URL=""
PLATE_API_TOKEN=""
# Cabecera de autenticación (vacío = no enviar cabecera) y prefijo del token
PLATE_API_AUTH_HEADER="Authorization"
PLATE_API_AUTH_SCHEME="Bearer"

# Carpeta donde se guardan las hojas del Libro de Reclamaciones (claims.jsonl).
# Por defecto: ./data. Usa una ruta con respaldo y fuera del directorio público.
CLAIMS_DATA_DIR=""

# ==============================================================================
# CORREO DEL LIBRO DE RECLAMACIONES (copia al cliente + aviso a la empresa)
# Usa el buzón de tu dominio. Ejemplo con Hostinger Email (confirma los datos en tu hPanel):
#   SMTP_HOST=smtp.hostinger.com  SMTP_PORT=465  SMTP_SECURE=true
# Si no se configura, los reclamos se guardan igual y la web avisa que no se envió la copia.
# ==============================================================================
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
# Remitente visible (por defecto SMTP_USER) y quién recibe el aviso interno (por defecto gerencia@norcelis.com)
MAIL_FROM=""
CLAIMS_NOTIFY_EMAIL=""
